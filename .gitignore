# ==========================================
# Gradle
# ==========================================
.gradle/
**/.gradle/
build/
**/build/

# Package Files (ignore jars, but preserve Gradle wrapper jar)
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar
!gradle/wrapper/gradle-wrapper.jar
!**/gradle/wrapper/gradle-wrapper.jar

# ==========================================
# Compiled Java Class Files & Binaries
# ==========================================
*.class
out/
**/out/
bin/
**/bin/
target/
**/target/
dist/
**/dist/

# ==========================================
# Database files (SQLite / H2 test databases)
# ==========================================
*.db
*.db-journal
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# ==========================================
# Runtime generated files & photo caches
# ==========================================
photos/
**/photos/

# ==========================================
# Logs & VM Dumps
# ==========================================
*.log
hs_err_pid*
replay_pid*
*.hprof

